<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox
    alignment="CEMTER"
    spacing="15"

    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"

    fx:controller="parking.controller.PaymentController">

    <!--Payment page title-->
    <Label text="Payment"/>

    <!--Enter parking session ID-->
    <TextField fx:id="sessionIdField"promptText="Session ID"/>

    <!--Enter payment amount-->
    <TextField fx:id="amountField"
    promptText="Amount"/>

    <!--Enter payment method-->
    <TextField fx:id="paymentMethodField" promptText="paymentMethod"/>

    <!--Process payment-->
    <Button text="Make Payment"onAction="#makePayment"/>
    </VBox